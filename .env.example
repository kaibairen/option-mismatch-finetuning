# Copy to .env on the AutoDL box or export in the shell.
# Never commit real values.

# AutoDL console → 账号 → 设置 → 开发者 Token
AUTODL_TOKEN=

# AutoDL 网页登录（手机号或邮箱 + 密码），仅在需要打开算力市场时使用
AUTODL_USERNAME=
AUTODL_PASSWORD=

# Optional: Hugging Face token for higher rate limits
HF_TOKEN=

# Default experiment settings
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
PROBE_LAYER=16
NUM_SAMPLES=30
